    },
    {
      "name": "Bob Johnson",
      "email": "bob@example.com",
      "max_shifts_per_week": 4,
      "max_consecutive_days": 6,
      "preferred_shifts": ["Night"]
    }
  ],
  "export_settings": {
    "default_format": "csv",
    "output_directory": "./schedules",
    "include_statistics": true
  }
}
